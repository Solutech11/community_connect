{
  "expo": {
    "name": "community_connect",
    "slug": "community_connect",
    "version": "1.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/community-connect-app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/community-connect-android-foreground.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E3B2A"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Community Connect to use your camera for community video calls.",
        "NSMicrophoneUsageDescription": "Allow Community Connect to use your microphone for community voice and video calls.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false,
      "bundleIdentifier": "com.solutech.communityconnect"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E3B2A",
        "foregroundImage": "./assets/community-connect-android-foreground.png",
        "backgroundImage": "./assets/community-connect-android-background.png",
        "monochromeImage": "./assets/community-connect-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "package": "com.solutech.community_connect"
    },
    "web": {
      "favicon": "./assets/community-connect-app-icon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Community Connect to use your camera to scan event tickets and join community video calls.",
          "recordAudioAndroid": true,
          "microphonePermission": "Allow Community Connect to use your microphone for community voice and video calls."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "color": "#08b657"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Community Connect to use Face ID for secure sign-in."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Community Connect to use your location to recommend nearby events."
        }
      ],
      "@rnmapbox/maps",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "extra": {
      "eas": {
        "projectId": "4111eebb-b42e-4cae-abff-b257d7f6b156"
      }
    }
  }
}
