# Set these to the backend reachable from your device.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://192.168.1.10:5000
# Socket logs: default on in development; false disables them.
EXPO_PUBLIC_SOCKET_LOGGING=true

EXPO_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
